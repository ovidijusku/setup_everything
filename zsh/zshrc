# ~/.zshrc — symlinked from setup_everything/zsh/zshrc by install.sh.
# Machine-specific or secret settings go in ~/.zshrc.local (not tracked).

# --- oh-my-zsh ---------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(
  git
  bundler
  dotenv
  macos
  rake
  rbenv   # runs `rbenv init`
  ruby
)
source "$ZSH/oh-my-zsh.sh"

# --- PATH --------------------------------------------------------------------
# Homebrew is set up in ~/.zprofile. ~/.local/bin comes first so uv's
# `python`/`python3` and `uv tool` binaries win over Homebrew's python.
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:${GOPATH:-$HOME/go}/bin"

# --- Local overrides ---------------------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# --- Plugins (syntax highlighting must be sourced last) ----------------------
[[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
